# Keep bazel_compatibility in sync with sonic-buildimage's .bazelversion.
module(
    name = "sonic-build-infra",
    version = "0.0.0",
    bazel_compatibility = [
        ">=8.5.1",
        "<=8.5.1",
    ],
)

bazel_dep(name = "swig", version = "4.1.0")
bazel_dep(name = "rules_cc", version = "0.2.14")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "tar.bzl", version = "0.10.5")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "bazel_lib", version = "3.1.1")

# A local module providing a cc_binary in a separate module, used only by our
# tests to prove that we correctly package binaries from another module.
bazel_dep(name = "deploy_tar_external_binary", version = "0.0.0", dev_dependency = True)
local_path_override(
    module_name = "deploy_tar_external_binary",
    path = "tests/external_binary_module",
)

bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.2", dev_dependency = True)

# TODO(bazel-ready): Upgrade rules_distroless when #183 merges
bazel_dep(name = "rules_distroless", version = "0.0.0.commit-ebfd74a2e07b83235e064bb63ace98a1a5223e02")

fetch_gcc = use_repo_rule("//toolchains/gcc:gcc.bzl", "fetch_gcc")

fetch_gcc(
    name = "gcc-linux-target-x86_64-host-x86_64",
    integrity = "sha256-OMlAdKIcGumB+5E4tGU9uMPlsObmJ7nv8YVg5ZjgGbQ=",
    target_arch = "x86_64",
    urls = ["https://github.com/blorente/gcc-builds/releases/download/13-07-2026/gcc-toolchain-12.5.0-x86_64.tar.xz"],
    version = "12.5.0",
)

fetch_gcc(
    name = "gcc-linux-target-aarch64-host-aarch64",
    integrity = "sha256-uDAQn8vGob0lhpFI8MNHZi6hHY1HvDxs+4+ZKLSu67s=",
    target_arch = "aarch64",
    urls = ["https://github.com/blorente/gcc-builds/releases/download/13-07-2026/gcc-toolchain-12.5.0-aarch64-host-aarch64.tar.xz"],
    version = "12.5.0",
)

register_toolchains(
    "//toolchains/gcc:host_x86_64_gcc_toolchain",
    "//toolchains/gcc:host_aarch64_gcc_toolchain",
    "//toolchains/binutils:host_x86_64_binutils_toolchain",
    "//toolchains/binutils:host_aarch64_binutils_toolchain",
)

ARCHITECTURES = [
    "amd64",
    "arm64",
]

apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.sources_list(
    architectures = ARCHITECTURES,
    components = ["main"],
    suites = [
        "bookworm",
        "bookworm-updates",
    ],
    uris = ["https://snapshot.debian.org/archive/debian/20251001T023456Z"],
)
apt.sources_list(
    architectures = ARCHITECTURES,
    components = ["main"],
    suites = ["bookworm-security"],
    uris = ["https://snapshot.debian.org/archive/debian-security/20251001T023456Z"],
)

# The cc toolchains' sysroot: libc, libstdc++ and kernel headers.
# We keep it in a separate apt install set so that the toolchain can resolve
# without fetching the entire closure of packages.
apt.install(
    dependency_set = "sysroot",
    packages = [
        "libc6-dev",
        "libgcc-12-dev",
        "libstdc++-12-dev",
        "linux-libc-dev",
    ],
    suites = [
        "bookworm",
        "bookworm-updates",
        "bookworm-security",
    ],
)
apt.install(
    dependency_set = "bookworm",
    packages = [
        # do not sort
        # debug utilities
        "gdb",
        "gdbserver",
        "vim",
        "strace",
        "openssh-client",
        "sshpass",

        # for sonic-swss-common
        "nlohmann-json3-dev",
        "libhiredis-dev",
        "libboost-dev",
        "libboost-serialization-dev",
        "uuid-dev",
        "libzmq3-dev",
        "libyang2-dev",
        "swig",
        "python3-dev",

        # for docker-sysmgr
        "libdbus-1-3",
        "libdbus-c++-1-0v5",
        "libprotobuf32",

        # for sonic-sysmgr
        "libdbus-c++-bin",
        "libdbus-c++-dev",
    ],
    suites = [
        "bookworm",
        "bookworm-updates",
        "bookworm-security",
    ],
)
use_repo(
    apt,
    # Re-export the hub repo, so that dependents on sonic-build-infra can get the whole central list
    # without having to declare their own dependencies.
    #
    # Dependents can use it by importing `sonic-build-infra` and loading it:
    #     apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
    #     use_repo(apt, "bookworm")
    "bookworm",

    # The cc toolchains' sysroot, resolved per architecture.
    "sysroot",
)

# Raw apt package repos the cc toolchains reach into (see use_repo below).
SYSROOT_PACKAGE_REPO_TEMPLATES = [
    "bookworm-security_linux-libc-dev-{arch}_6.1.153-1",
    "bookworm_libc6-{arch}_2.36-9-deb12u13",
    "bookworm_libc6-dev-{arch}_2.36-9-deb12u13",
    "bookworm_libgcc-12-dev-{arch}_12.2.0-14-deb12u1",
    "bookworm_libgcc-s1-{arch}_12.2.0-14-deb12u1",
    "bookworm_libstdc---12-dev-{arch}_12.2.0-14-deb12u1",
    "bookworm_libstdc--6-{arch}_12.2.0-14-deb12u1",
]

SYSROOT_PACKAGE_REPOS = [
    template.format(arch = arch)
    for template in SYSROOT_PACKAGE_REPO_TEMPLATES
    for arch in ARCHITECTURES
]

[
    use_repo(apt, repo)
    for repo in SYSROOT_PACKAGE_REPOS
]
