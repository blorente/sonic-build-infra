load("@bazel_lib//lib:diff_test.bzl", "diff_test")
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")
load("@tar.bzl", "mutate", "tar")
load("//binary:assert_stripped.bzl", "assert_stripped")
load("//binary:keep_debug_info.bzl", "keep_debug_info")
load("//binary:strip_binary.bzl", "strip_binary")
load("//tar:assert_tar.bzl", "assert_tar")
load("//tar:sonic_deploy_tar.bzl", "sonic_deploy_tar")

#############################
#   assert_tar & tar tests  #
#############################

write_file(
    name = "small_file",
    out = "small_file.txt",
    content = ["short"],
)

write_file(
    name = "large_file",
    out = "large_file.txt",
    content = ["a much longer string with more content"],
)

tar(
    name = "simple_tar_mutate",
    srcs = ["//tests/testdata:file.txt"],
    mutate = mutate(
        package_dir = "./usr/lib",
        strip_prefix = package_name() + "/testdata",
    ),
)

assert_tar(
    name = "simple_tar_mutate_assert",
    expected = ":simple_tar.expected.txt",
    tar = ":simple_tar_mutate",
)

tar(
    name = "simple_tar_mtree",
    srcs = ["//tests/testdata:file.txt"],
    mtree = [
        ". time=946699200 mode=0755 type=dir",
        "./usr uid=0 gid=0 time=946699200 mode=0755 type=dir",
        "./usr/lib uid=0 gid=0 time=946699200 mode=0755 type=dir",
        "./usr/lib/file.txt uid=0 gid=0 time=1672560000 mode=0755 type=file content=$(location //tests/testdata:file.txt)",
    ],
)

assert_tar(
    name = "simple_tar_mtree_assert",
    expected = ":simple_tar.expected.txt",
    tar = ":simple_tar_mtree",
)

tar(
    name = "inconsistent_sizes_tar_small",
    srcs = [
        ":small_file",
        "//tests/testdata:file.txt",
    ],
    mtree = [
        ". uid=0 gid=0 time=946699200 mode=0755 type=dir",
        "./usr uid=0 gid=0 time=946699200 mode=0755 type=dir",
        "./usr/lib uid=0 gid=0 time=946699200 mode=0755 type=dir",
        "./usr/lib/file.txt uid=0 gid=0 time=1672560000 mode=0755 type=file content=$(location //tests/testdata:file.txt)",
        "./usr/lib/variable.txt uid=0 gid=0 time=1672560000 mode=0755 type=file content=$(location :small_file)",
    ],
)

# Reference implementation used only to generate the golden file for testing
# tars with inconsistent sizes. Not built as part of the regular test suite.
tar(
    name = "inconsistent_sizes_tar_large",
    srcs = [
        ":large_file",
        "//tests/testdata:file.txt",
    ],
    mtree = [
        ". uid=0 gid=0 time=946699200 mode=0755 type=dir",
        "./usr uid=0 gid=0 time=946699200 mode=0755 type=dir",
        "./usr/lib uid=0 gid=0 time=946699200 mode=0755 type=dir",
        "./usr/lib/file.txt uid=0 gid=0 time=1672560000 mode=0755 type=file content=$(location //tests/testdata:file.txt)",
        "./usr/lib/variable.txt uid=0 gid=0 time=1672560000 mode=0755 type=file content=$(location :large_file)",
    ],
    tags = ["manual"],
)

assert_tar(
    name = "inconsistent_sizes_assert",
    expected = ":inconsistent_sizes.expected.txt",
    inconsistent_sizes = ["./usr/lib/variable.txt"],
    tar = ":inconsistent_sizes_tar_small",
)

#########################
#   strip_binary tests  #
#########################

# Test that a C executable strips correctly.
cc_binary(
    name = "hello",
    srcs = ["//tests/testdata:hello.c"],
)

build_test(
    name = "hello_build_test",
    targets = [":hello"],
)

strip_binary(
    name = "hello_strip",
    src = ":hello",
    force_debug_build = True,
)

assert_stripped(
    name = "hello_strip_test",
    strip_target = ":hello_strip",
)

# Same flow, but for a shared library (.so) via cc_binary(linkshared = True).
cc_binary(
    name = "libgreet.so",
    srcs = ["//tests/testdata:greet.c"],
    linkshared = True,
)

build_test(
    name = "libgreet_build_test",
    targets = [":libgreet.so"],
)

keep_debug_info(
    name = "libgreet_debug",
    src = ":libgreet.so",
)

strip_binary(
    name = "libgreet_strip",
    src = ":libgreet_debug",
)

assert_stripped(
    name = "libgreet_strip_test",
    strip_target = ":libgreet_strip",
)

# Same flow again, but for a shared library built via cc_shared_library.
cc_library(
    name = "greet_lib",
    srcs = ["//tests/testdata:greet.c"],
)

cc_shared_library(
    name = "greet_shared",
    deps = [":greet_lib"],
)

build_test(
    name = "greet_shared_build_test",
    targets = [":greet_shared"],
)

keep_debug_info(
    name = "greet_shared_debug",
    src = ":greet_shared",
)

strip_binary(
    name = "greet_shared_strip",
    src = ":greet_shared_debug",
)

assert_stripped(
    name = "greet_shared_strip_test",
    strip_target = ":greet_shared_strip",
)

#############################
#   sonic_deploy_tar tests  #
#############################

sonic_deploy_tar(
    name = "hello_deploy_tar",
    srcs = ["//tests/testdata:file.txt"],
    binaries = {
        "./usr/bin/hello uid=0 gid=0 time=1672560000 mode=0755 type=file": ":hello",
    },
    force_debug_build = True,
    mtree = [
        ". time=946699200 mode=0755 type=dir",
        "./usr uid=0 gid=0 time=946699200 mode=0755 type=dir",
        "./usr/bin uid=0 gid=0 time=946699200 mode=0755 type=dir",
        "./usr/share uid=0 gid=0 time=946699200 mode=0755 type=dir",
        "./usr/share/file.txt uid=0 gid=0 time=1672560000 mode=0755 type=file content=$(location //tests/testdata:file.txt)",
    ],
)

# Assert the tar has roughly the shape we expect
assert_tar(
    name = "hello_deploy_tar_assert",
    expected = ":hello_deploy_tar.expected.txt",
    inconsistent_sizes = ["./usr/bin/hello"],
    tar = ":hello_deploy_tar",
)

# Assert the packaged binary is the stripped version.
strip_binary(
    name = "hello_deploy_expected_strip",
    src = ":hello",
    force_debug_build = True,
)

filegroup(
    name = "hello_deploy_expected_stripped",
    testonly = True,
    srcs = [":hello_deploy_expected_strip"],
    output_group = "stripped",
)

genrule(
    name = "hello_deploy_extracted_hello",
    testonly = True,
    srcs = [":hello_deploy_tar"],
    outs = ["hello_deploy_extracted_hello.bin"],
    cmd = "$(BSDTAR_BIN) xOf $(execpath :hello_deploy_tar) ./usr/bin/hello > $@",
    toolchains = ["@tar.bzl//tar/toolchain:type"],
)

diff_test(
    name = "hello_deploy_tar_content_test",
    timeout = "short",
    file1 = ":hello_deploy_extracted_hello.bin",
    file2 = ":hello_deploy_expected_stripped",
)

# The debug tar lays the .debug out under /usr/lib/debug/.build-id/NN/REST.debug.
assert_tar(
    name = "hello_deploy_tar_debug_assert",
    expected = ":hello_deploy_tar_debug.expected.txt",
    tar = ":hello_deploy_tar.debug_symbols",
)

# Prove sonic_deploy_tar works with a binary from a *different bazel module*:
# strip it, build the stripped payload tar and the .build-id debug tar.
sonic_deploy_tar(
    name = "external_deploy_tar",
    binaries = {
        "./usr/bin/external_hello uid=0 gid=0 time=1672560000 mode=0755 type=file": "@deploy_tar_external_binary//:external_hello",
    },
    force_debug_build = True,
    mtree = [
        ". time=946699200 mode=0755 type=dir",
        "./usr uid=0 gid=0 time=946699200 mode=0755 type=dir",
        "./usr/bin uid=0 gid=0 time=946699200 mode=0755 type=dir",
    ],
)

build_test(
    name = "external_deploy_tar_build_test",
    targets = [
        ":external_deploy_tar",
        ":external_deploy_tar.debug_symbols",
    ],
)
