load("//toolchains/gcc:defs.bzl", "bin")
load(":binutils_toolchain.bzl", "binutils_toolchain")

licenses(["notice"])

# Binutils that rules need *outside* of a cc action: //binary:strip_binary splits
# an ELF with objcopy, and //binary:assert_stripped reads it back with
# objdump/readelf.
#
# They can't come from the cc toolchain, because CcToolchainInfo exposes objcopy
# but neither readelf nor objdump.
# They can't be plain exec-config label attrs, because we also care that they
# understand the target platform.
toolchain_type(
    name = "toolchain_type",
    visibility = ["//visibility:public"],
)

binutils_toolchain(
    name = "host_x86_64_binutils",
    objcopy = bin("@gcc-linux-target-x86_64-host-x86_64", "x86_64", "objcopy"),
    objdump = bin("@gcc-linux-target-x86_64-host-x86_64", "x86_64", "objdump"),
    readelf = bin("@gcc-linux-target-x86_64-host-x86_64", "x86_64", "readelf"),
)

toolchain(
    name = "host_x86_64_binutils_toolchain",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    toolchain = ":host_x86_64_binutils",
    toolchain_type = ":toolchain_type",
)

binutils_toolchain(
    name = "host_aarch64_binutils",
    objcopy = bin("@gcc-linux-target-aarch64-host-aarch64", "aarch64", "objcopy"),
    objdump = bin("@gcc-linux-target-aarch64-host-aarch64", "aarch64", "objdump"),
    readelf = bin("@gcc-linux-target-aarch64-host-aarch64", "aarch64", "readelf"),
)

toolchain(
    name = "host_aarch64_binutils_toolchain",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
    toolchain = ":host_aarch64_binutils",
    toolchain_type = ":toolchain_type",
)
